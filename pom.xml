<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>me.rageoffire</groupId>
    <artifactId>ROF_PlayerVault</artifactId>
    <version>2.0.0</version>
    <packaging>jar</packaging>

    <name>ROF_PlayerVault</name>
    <description>A Minecraft plugin to store player items inside a virtual inventory</description>

    <properties>
        <java.version>8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>spigot-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Spigot API -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.12.2-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- Vault (Economy) -->
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- PlaceholderAPI -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.12.3</version>
            <scope>provided</scope>
        </dependency>

        <!-- HikariCP — connection pool (~130 KB shaded) -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>4.0.3</version>
            <scope>compile</scope>
        </dependency>

        <!--
            MySQL Connector/J — shaded but STRIPPED of heavy optional deps:
            - protobuf   (~1.8 MB) — only needed for X Protocol (MySQL 8 extra feature)
            - Google Failsafe / OpenTelemetry — telemetry, not needed in a plugin
            Stripping these keeps the connector contribution to ~400 KB instead of ~2.5 MB.
            On servers that already have the driver (Paper 1.16+) the classes are simply
            ignored at load time — no conflict because we relocate the package.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.4.0</version>
            <scope>compile</scope>
            <exclusions>
                <!-- Removes ~1.8 MB of protobuf (X Protocol only) -->
                <exclusion>
                    <groupId>com.google.protobuf</groupId>
                    <artifactId>protobuf-java</artifactId>
                </exclusion>
                <!-- Removes OpenTelemetry telemetry (~300 KB) -->
                <exclusion>
                    <groupId>io.opentelemetry</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <!-- Removes Failsafe (~80 KB) -->
                <exclusion>
                    <groupId>dev.failsafe</groupId>
                    <artifactId>failsafe</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <relocations>
                                <!-- Relocate HikariCP to avoid conflicts with other plugins -->
                                <relocation>
                                    <pattern>com.zaxxer.hikari</pattern>
                                    <shadedPattern>me.rageoffire.rofplayervault.libs.hikari</shadedPattern>
                                </relocation>
                                <!-- Relocate MySQL driver to avoid conflicts with server's own driver -->
                                <relocation>
                                    <pattern>com.mysql</pattern>
                                    <shadedPattern>me.rageoffire.rofplayervault.libs.mysql</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <!-- Strip signatures -->
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                                <!-- Strip unused MySQL classes to shrink jar further -->
                                <filter>
                                    <artifact>com.mysql:mysql-connector-j</artifact>
                                    <excludes>
                                        <!-- X DevAPI / X Protocol (requires protobuf, not used) -->
                                        <exclude>com/mysql/cj/xdevapi/**</exclude>
                                        <exclude>com/mysql/cj/protocol/x/**</exclude>
                                        <!-- Telemetry / OpenTelemetry stubs -->
                                        <exclude>com/mysql/cj/telemetry/**</exclude>
                                        <!-- Unused charsets (keeps only UTF-8 and common ones) -->
                                        <exclude>com/mysql/cj/jdbc/ha/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
</project>
